DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monitoring
JWT_SECRET_KEY=change-this-secret-key-in-production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=monitoring-reviews
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=http://localhost:3000/kakao-callback
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10

# --- 통계 분석 챗봇 (OpenAI) ---
# 비워두면 챗봇 API가 503을 돌려주고 프론트는 버튼을 숨긴다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
STATS_CHAT_MAX_OUTPUT_TOKENS=1200
STATS_CHAT_ROW_LIMIT=200
STATS_CHAT_SQL_TIMEOUT_MS=5000
STATS_CHAT_MAX_SQL_CALLS=6
STATS_CHAT_RATE_LIMIT_PER_MINUTE=10
